{
  "name": "property-management-backend",
  "version": "1.0.0",
  "description": "PropertyOS Backend - Microservices API",
  "private": true,
  "workspaces": [
    "services/*",
    "shared/*",
    "gateway"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:gateway\" \"npm run dev:auth\" \"npm run dev:property\" \"npm run dev:tenant\" \"npm run dev:payment\"",
    "dev:gateway": "cd gateway && npm run dev",
    "dev:auth": "cd services/auth-service && npm run dev",
    "dev:property": "cd services/property-service && npm run dev",
    "dev:tenant": "cd services/tenant-service && npm run dev",
    "dev:payment": "cd services/payment-service && npm run dev",
    "dev:maintenance": "cd services/maintenance-service && npm run dev",
    "dev:vendor": "cd services/vendor-service && npm run dev",
    "dev:communication": "cd services/communication-service && npm run dev",
    "dev:reporting": "cd services/reporting-service && npm run dev",
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces",
    "test:cov": "npm run test:cov --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "db:migrate": "cd shared/database && npm run migrate",
    "db:seed": "cd shared/database && npm run seed",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "concurrently": "^8.2.2",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/greyzone/property-management-backend"
  }
}